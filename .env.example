DB_HOST=s-mysql-service-fastapi
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=appdb

APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production

RABBITMQ_HOST=s-rabbitmq-service-fastapi
RABBITMQ_PORT=5672
RABBITMQ_USER=airplus
RABBITMQ_PASSWORD=airplus-dev-only-change-me
RABBITMQ_VHOST=accounting
RABBITMQ_MANAGEMENT_PORT=45683
RABBITMQ_AMQP_PORT=45684

# Messaging workers — optional tuning (these are the defaults)
MESSAGING_RELAY_POLL_INTERVAL_MS=500
MESSAGING_RELAY_BATCH_SIZE=100
MESSAGING_RELAY_MAX_ATTEMPTS=10
MESSAGING_RETRY_MAX_ATTEMPTS=3
MESSAGING_RETRY_BASE_DELAY_MS=2000

# Direct entry of accounting-document content in the ledger:
# enabled (development) / console_only (test console only) / disabled (documents only from subsystems)
LEDGER_DIRECT_ENTRY_MODE=enabled
